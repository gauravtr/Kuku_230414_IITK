# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > Settings > Secrets
NYAY_PROVIDER = "gemini"          # gemini | groq | openai | openrouter | anthropic | ollama
NYAY_MODEL = "gemini-2.5-flash"   # any model the provider serves
GEMINI_API_KEY = "paste-your-free-key-from-aistudio.google.com"
# GROQ_API_KEY = "..."            # free tier, also enables Whisper voice
